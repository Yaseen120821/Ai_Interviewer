# ─────────────────────────────────────────────────────────────
# Ai_Interviewer Client Environment Variables (.env.example)
# ─────────────────────────────────────────────────────────────

# Backend Express API Base URL
VITE_API_URL=http://localhost:5000/api/v1

# Razorpay Key ID (for testing checkout popup)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# ─────────────────────────────────────────────────────────────
# Firebase Configuration (Spark Free Plan — Auth + Firestore ONLY)
# Project: clinic appointment
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=clinic-appointment.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clinic-appointment
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Next.js compatibility aliases (optional)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=clinic-appointment.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=clinic-appointment
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

