// Ai_Interviewer — Prisma Schema
// PostgreSQL | Prisma ORM 7.x

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum Role {
  student
  admin
}

enum InterviewType {
  technical
  behavioral
  hr
  coding
  simulation
}

enum InterviewMode {
  text
  voice
  avatar
}

enum Difficulty {
  easy
  medium
  hard
  adaptive
}

enum SessionStatus {
  pending
  active
  completed
  abandoned
}

enum TopicStatus {
  not_started
  in_progress
  done
}

enum Priority {
  high
  medium
  low
}

enum ResourceType {
  article
  video
  problem
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  instantUserId String?  @unique
  name          String
  email         String   @unique
  passwordHash  String?
  role          Role     @default(student)
  profileImage  String?
  credits       Int      @default(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  resumes        Resume[]
  sessions       InterviewSession[]
  reports        Report[]
  roadmaps       LearningRoadmap[]
  atsAnalyses    AtsAnalysis[]
  submissions    CodeSubmission[]
  transactions   CreditTransaction[]

  @@map("users")
}

model Resume {
  id         String   @id @default(cuid())
  userId     String
  fileName   String
  filePath   String
  parsedText String   @db.Text
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    InterviewSession[]
  atsAnalyses AtsAnalysis[]

  @@map("resumes")
}

model InterviewSession {
  id                  String        @id @default(cuid())
  userId              String
  resumeId            String?
  type                InterviewType @default(technical)
  mode                InterviewMode @default(avatar)
  roleTarget          String
  experienceLevel     String        @default("Fresher")
  difficulty          Difficulty    @default(medium)
  status              SessionStatus @default(pending)
  isAdaptive          Boolean       @default(true)
  timeLimitPerQuestion Int          @default(90) // seconds
  jobDescription      String?       @db.Text
  totalDuration       Int?          // seconds
  createdAt           DateTime      @default(now())
  completedAt         DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume           Resume?           @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  questions        SessionQuestion[]
  answers          UserAnswer[]
  codingChallenges CodingChallenge[]
  report           Report?

  @@map("interview_sessions")
}

model SessionQuestion {
  id           String     @id @default(cuid())
  sessionId    String
  questionText String     @db.Text
  topic        String
  difficulty   Difficulty
  orderIndex   Int
  timeLimit    Int?       // per-question timer in seconds

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answer  UserAnswer?

  @@map("session_questions")
}

model UserAnswer {
  id                 String   @id @default(cuid())
  questionId         String   @unique
  sessionId          String
  answerText         String   @db.Text
  timeTaken          Int      // seconds
  confidenceScore    Float?   // 0.0 - 10.0
  communicationScore Float?   // 0.0 - 10.0
  correctnessScore   Float?   // 0.0 - 10.0
  submittedAt        DateTime @default(now())

  session  InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question SessionQuestion  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  feedback AIFeedback?

  @@map("user_answers")
}

model AIFeedback {
  id            String   @id @default(cuid())
  answerId      String   @unique
  score         Float    // 0.0 – 10.0
  correctness   String   @db.Text
  communication String   @db.Text
  improvements  String[]
  modelUsed     String   @default("gemini-2.5-flash")
  generatedAt   DateTime @default(now())

  answer UserAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@map("ai_feedback")
}

model Report {
  id             String   @id @default(cuid())
  sessionId      String   @unique
  userId         String
  overallScore   Float
  summary        String   @db.Text
  strengths      String[]
  weaknesses     String[]
  topicScores    Json     // { "Arrays": 7.5, "Confidence": 8.0, "Correctness": 7.0 }
  recommendation String   @db.Text
  generatedAt    DateTime @default(now())

  session  InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmaps LearningRoadmap[]

  @@map("reports")
}

model LearningRoadmap {
  id             String   @id @default(cuid())
  userId         String
  roleTarget     String
  sourceReportId String?
  createdAt      DateTime @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceReport Report?         @relation(fields: [sourceReportId], references: [id], onDelete: SetNull)
  topics       RoadmapTopic[]

  @@map("learning_roadmaps")
}

model RoadmapTopic {
  id          String      @id @default(cuid())
  roadmapId   String
  title       String
  description String      @db.Text
  status      TopicStatus @default(not_started)
  priority    Priority
  orderIndex  Int

  roadmap   LearningRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  resources TopicResource[]

  @@map("roadmap_topics")
}

model TopicResource {
  id            String       @id @default(cuid())
  topicId       String
  title         String
  url           String
  type          ResourceType
  estimatedTime String

  topic RoadmapTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("topic_resources")
}

// ─────────────────────────────────────────────
// Coding Assessment Models
// ─────────────────────────────────────────────

model CodingChallenge {
  id           String     @id @default(cuid())
  sessionId    String?
  title        String
  description  String     @db.Text
  difficulty   Difficulty @default(medium)
  category     String     @default("Algorithms")
  inputFormat  String     @db.Text
  outputFormat String     @db.Text
  constraints  String     @db.Text
  starterCode  Json       // { "python": "...", "javascript": "...", "java": "...", "cpp": "..." }
  examples     Json       // [ { "input": "...", "output": "...", "explanation": "..." } ]
  testCases    Json       // [ { "input": "...", "output": "...", "hidden": false } ]
  createdAt    DateTime   @default(now())

  session     InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  submissions CodeSubmission[]

  @@map("coding_challenges")
}

model CodeSubmission {
  id           String   @id @default(cuid())
  challengeId  String
  userId       String
  language     String
  code         String   @db.Text
  status       String   @default("submitted") // "passed", "failed", "error"
  score        Float    @default(0)
  testResults  Json     // [ { "passed": true, "input": "...", "output": "...", "expected": "..." } ]
  aiEvaluation Json?    // { "correctness": 8, "quality": 9, "timeComplexity": "O(N)", "feedback": "..." }
  runtimeMs    Int?
  memoryKb     Int?
  submittedAt  DateTime @default(now())

  challenge CodingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("code_submissions")
}

// ─────────────────────────────────────────────
// ATS Resume Analysis Model
// ─────────────────────────────────────────────

model AtsAnalysis {
  id                  String   @id @default(cuid())
  userId              String
  resumeId            String?
  targetRole          String
  jobDescription      String?  @db.Text
  atsScore            Int      // 0 - 100
  matchingKeywords    String[]
  missingKeywords     String[]
  strengths           String[]
  weaknesses          String[]
  sectionFeedback     Json     // { "summary": "...", "skills": "...", "experience": "..." }
  suggestions         String[]
  optimizedResumeText String?  @db.Text
  createdAt           DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume? @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  @@map("ats_analyses")
}

// ─────────────────────────────────────────────
// Credits & Razorpay Transactions
// ─────────────────────────────────────────────

model CreditTransaction {
  id                 String   @id @default(cuid())
  userId             String
  amount             Int      // positive for topup, negative for interview usage
  type               String   // "signup_bonus", "interview_deduction", "razorpay_topup"
  description        String
  razorpayOrderId    String?
  razorpayPaymentId  String?
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("credit_transactions")
}

